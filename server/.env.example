PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Clusters → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/artisan_marketplace?retryWrites=true&w=majority

# A long random secret for signing JWTs (use any random string in production)
JWT_SECRET=change_this_to_a_long_random_secret

# Only needed in local development (Vite proxy handles this in prod)
CLIENT_URL=http://localhost:5173

# Optional: Anthropic Claude API key for AI product descriptions
# Without this the server uses template-based fallback descriptions
ANTHROPIC_API_KEY=

# Seeded admin account (used by: node server/seed.js)
ADMIN_EMAIL=admin@artisan.local
ADMIN_PASSWORD=Admin@12345
